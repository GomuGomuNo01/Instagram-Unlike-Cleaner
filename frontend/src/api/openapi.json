      "post": {
        "tags": [
          "session"
        ],
        "summary": "Start Session",
        "description": "Ouvre le navigateur visible sur instagram.com : l'utilisateur s'y connecte lui-même.",
        "operationId": "start_session_api_session_start_post",
        "responses": {
          "200": {
            "description": "Successful Response",
