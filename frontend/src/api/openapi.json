  "components": {
    "schemas": {
      "CleanupFilters": {
        "properties": {
          "sort": {
            "$ref": "#/components/schemas/SortOrder",
            "description": "« Trier par ».",
            "default": "newest_first"
          },
          "start_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Date",
            "description": "Date de début, date du like (vide : sans limite)."
          },
          "end_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Date",
            "description": "Date de fin, date du like (vide : aujourd'hui)."
          }
        },
        "type": "object",
        "title": "CleanupFilters",
        "description": "Critères d'un nettoyage : le filtre d'Instagram, tel que le propose Instagram web dans\nle panneau « Trier et filtrer » de la page des likes (tri, date de début et date de fin\ndu like). IUC applique ces critères en remplissant ce panneau ; il n'en ajoute aucun.\n\nLes champs inconnus sont ignorés : les nettoyages enregistrés avant la refonte du\nfiltrage (type de contenu, comptes) restent lisibles."
      },
      "DeletedOut": {
        "properties": {
          "deleted": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Deleted"
          }
        },
        "type": "object",
        "required": [
          "deleted"
        ],
        "title": "DeletedOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ItemOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "rank": {
            "type": "integer",
            "title": "Rank",
            "description": "Rang dans l'aperçu, à partir de 1."
          },
          "media_key": {
            "type": "string",
            "title": "Media Key"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "author": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Author"
          },
          "media_kind": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MediaKind"
              },
              {
                "type": "null"
              }
            ]
          },
          "shared_on": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Shared On",
            "description": "Date « partagée le » affichée par Instagram."
          },
          "status": {
            "$ref": "#/components/schemas/ItemStatus"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "processed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Processed At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "rank",
          "media_key",
          "label",
          "author",
          "media_kind",
          "shared_on",
          "status",
          "error",
          "processed_at"
        ],
        "title": "ItemOut"
      },
      "ItemStatus": {
        "type": "string",
        "enum": [
          "pending",
          "selected",
          "excluded",
          "done",
          "failed",
          "skipped"
        ],
        "title": "ItemStatus"
      },
      "ItemsPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ItemOut"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "offset",
          "limit"
        ],
        "title": "ItemsPage"
      },
      "ItemsPatch": {
        "properties": {
          "item_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "minItems": 1,
            "title": "Item Ids"
          },
          "excluded": {
            "type": "boolean",
            "title": "Excluded",
            "description": "true : décocher (exclure) ; false : recocher."
          }
        },
        "type": "object",
        "required": [
          "item_ids",
          "excluded"
        ],
        "title": "ItemsPatch"
      },
      "ItemsPatchOut": {
        "properties": {
          "changed": {
            "type": "integer",
            "title": "Changed"
          },
          "job": {
            "$ref": "#/components/schemas/JobOut"
          }
        },
        "type": "object",
        "required": [
          "changed",
          "job"
        ],
        "title": "ItemsPatchOut"
      },
      "JobCreate": {
        "properties": {
          "sort": {
            "$ref": "#/components/schemas/SortOrder",
            "description": "« Trier par ».",
            "default": "newest_first"
          },
          "start_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Date",
            "description": "Date de début, date du like (vide : sans limite)."
          },
          "end_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
