{
  "openapi": "3.1.0",
  "info": {
    "title": "IUC – API locale",
    "description": "API locale d'Instagram Unlike Cleaner. Toutes les routes /api exigent le jeton affiché par `iuc serve`, dans l'en-tête X-IUC-Token.",
    "version": "0.1.0"
  },
