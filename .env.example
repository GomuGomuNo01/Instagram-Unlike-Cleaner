DATA_DIR=./data
# Valeurs prudentes provisoires, à ajuster après les tests sur le compte secondaire
# Unlikes tentés par jour (date locale), tous nettoyages confondus
DAILY_LIMIT=150
# Pause tirée au hasard entre deux lots, en secondes
DELAY_MIN=4
DELAY_MAX=12
# Likes retirés par lot, c'est-à-dire par clic sur « Je n’aime plus »
BATCH_SIZE=20
# Niveau de détail des journaux : DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Port de l'API locale (toujours sur 127.0.0.1)
API_PORT=8765
# Page /docs de l'API : chargée depuis un CDN tiers, donc désactivée par défaut
API_DOCS=false
# Recherche des nouvelles versions sur GitHub (lecture seule) ; activée dans l'application Windows
UPDATE_CHECK=false
